FROM docker.io/library/rust:1.99-bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        desktop-file-utils \
        dpkg-dev \
        file \
        libfuse2 \
        libgdk-pixbuf2.0-bin \
        libglib2.0-bin \
        libgtk-4-dev \
        librsvg2-dev \
        pkg-config \
        squashfs-tools \
        xz-utils \
        zsync \
    && rm -rf /var/lib/apt/lists/*

RUN rustup component add rustfmt clippy

WORKDIR /workspace
